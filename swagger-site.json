    "/api/v1/blogs": {
      "get": {
        "description": "Get all published blogs for public site",
        "operationId": "site-get-all-blogs",
        "parameters": [
          {
            "name": "search",
            "required": false,
            "in": "query",
            "description": "Search by title or excerpt",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "required": false,
            "in": "query",
            "description": "Page number (optional)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "description": "Items per page (optional)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        },
        "summary": "site-get-all-blogs",
        "tags": [
          "Site - Blogs"
        ]
      }
    },
    "/api/v1/blogs/{slugOrId}": {
